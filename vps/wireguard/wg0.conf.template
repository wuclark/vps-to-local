# WireGuard Server Config — VPS side
# Place at: /etc/wireguard/wg0.conf
# Permissions: chmod 600 /etc/wireguard/wg0.conf
#
# Start:   systemctl enable wg-quick@wg0 --now
# Reload:  wg syncconf wg0 <(wg-quick strip wg0)
# Status:  wg show

[Interface]
Address = 10.0.0.1/24
ListenPort = 51820
PrivateKey = <SERVER_PRIVATE_KEY>

# Optional: log handshakes (useful for debugging)
# PostUp   = wg set wg0 fwmark 51820
# PostDown = wg set wg0 fwmark 0

# ─────────────────────────────────────────────
# Peer: Laptop
# WireGuard IP: 10.0.0.2
# Mapped to public: <PUBLIC_IP_1>
# ─────────────────────────────────────────────
[Peer]
PublicKey = <LAPTOP_PUBLIC_KEY>
AllowedIPs = 10.0.0.2/32

# ─────────────────────────────────────────────
# Peer: Desktop
# WireGuard IP: 10.0.0.3
# Mapped to public: <PUBLIC_IP_2>
# ─────────────────────────────────────────────
[Peer]
PublicKey = <DESKTOP_PUBLIC_KEY>
AllowedIPs = 10.0.0.3/32
