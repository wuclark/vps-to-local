# WireGuard Server Config — VPS side
# Place at: /etc/wireguard/wg0.conf
# Permissions: chmod 600 /etc/wireguard/wg0.conf
#
# Start:   systemctl enable wg-quick@wg0 --now
# Reload:  wg syncconf wg0 <(wg-quick strip wg0)
# Status:  wg show

[Interface]
Address = 10.0.0.1/24
ListenPort = 51820
PrivateKey = <SERVER_PRIVATE_KEY>

# Peers are added below by: bash scripts/add-peer.sh <name> [--public-ip <IP>]
